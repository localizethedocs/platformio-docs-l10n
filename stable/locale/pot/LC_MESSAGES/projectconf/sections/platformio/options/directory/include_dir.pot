#: ../../../projectconf/sections/platformio/options/directory/include_dir.rst:15
msgid "``include_dir``"
msgstr ""

#: ../../../projectconf/sections/platformio/options/directory/include_dir.rst:17
msgid ""
"Type: ``DirPath`` | Multiple: ``No`` | Default: \"<Project>/``include``\""
msgstr ""

#: ../../../projectconf/sections/platformio/options/directory/include_dir.rst:19
msgid ""
"The path to project's default header files. PlatformIO uses it for the :ref:"
"`cmd_run` command. The default value is ``include`` meaning an ``include`` "
"directory located under the root directory of the project. This path will be "
"added to ``CPPPATH`` of the build environment."
msgstr ""

#: ../../../projectconf/sections/platformio/options/directory/include_dir.rst:24
msgid ""
"If you need to add extra include directories to ``CPPPATH`` scope, please "
"use :ref:`projectconf_build_flags` with ``-I /path/to/extra/dir`` option."
msgstr ""

#: ../../../projectconf/sections/platformio/options/directory/include_dir.rst:27
msgid ""
"This option can also be configured by the global environment variable :"
"envvar:`PLATFORMIO_INCLUDE_DIR`."
msgstr ""
