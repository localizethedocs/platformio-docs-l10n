#: ../../../projectconf/sections/env/options/check/check_src_filters.rst:17
msgid "``check_src_filters``"
msgstr ""

#: ../../../projectconf/sections/env/options/check/check_src_filters.rst:19
msgid "Type: ``String (Templates)`` | Multiple: ``Yes``"
msgstr ""

#: ../../../projectconf/sections/env/options/check/check_src_filters.rst:21
msgid ""
"This option allows one to specify which files should be included or excluded "
"from the check process. The filter supports two templates:"
msgstr ""

#: ../../../projectconf/sections/env/options/check/check_src_filters.rst:24
msgid "``+<PATH>`` include template"
msgstr ""

#: ../../../projectconf/sections/env/options/check/check_src_filters.rst:25
msgid "``-<PATH>`` exclude template"
msgstr ""

#: ../../../projectconf/sections/env/options/check/check_src_filters.rst:27
msgid ""
"``PATH`` is relative to :ref:`projectconf_pio_src_dir`. All patterns will be "
"applied in their order of definition. `GLOB Patterns <http://en.wikipedia."
"org/wiki/Glob_(programming)>`_ are allowed."
msgstr ""

#: ../../../projectconf/sections/env/options/check/check_src_filters.rst:31
msgid ""
"By default, ``check_src_filters`` is predefined to include ALL files from "
"the :ref:`projectconf_pio_src_dir` and :ref:`projectconf_pio_include_dir` "
"folders."
msgstr ""

