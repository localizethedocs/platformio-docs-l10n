#: ../../../projectconf/sections/env/options/debug/debug_load_mode.rst:15
msgid "``debug_load_mode``"
msgstr ""

#: ../../../projectconf/sections/env/options/debug/debug_load_mode.rst:17
msgid "Type: ``String`` | Multiple: ``No`` | Default: ``always``"
msgstr ""

#: ../../../projectconf/sections/env/options/debug/debug_load_mode.rst:19
msgid ""
"Allows one to control when PlatformIO should load debugging firmware to the "
"end target. Possible options:"
msgstr ""

#: ../../../projectconf/sections/env/options/debug/debug_load_mode.rst:22
msgid "``always`` - load for the each debugging session, **default**"
msgstr ""

#: ../../../projectconf/sections/env/options/debug/debug_load_mode.rst:23
msgid "``modified`` - load only when firmware was modified"
msgstr ""

#: ../../../projectconf/sections/env/options/debug/debug_load_mode.rst:24
msgid ""
"``manual`` - do not load firmware automatically. You are responsible to pre-"
"flash target with debugging firmware in this case."
msgstr ""
