#: ../../../projectconf/sections/env/options/library/lib_archive.rst:15
msgid "``lib_archive``"
msgstr ""

#: ../../../projectconf/sections/env/options/library/lib_archive.rst:17
msgid "Type: ``Bool (yes or no)`` | Multiple: ``No`` | Default: ``yes``"
msgstr ""

#: ../../../projectconf/sections/env/options/library/lib_archive.rst:19
msgid ""
"Create an archive (``*.a``, static library) from the object files and link "
"it into a firmware (program). This is default behavior of PlatformIO Build "
"System (``lib_archive = yes``)."
msgstr ""

#: ../../../projectconf/sections/env/options/library/lib_archive.rst:23
msgid ""
"Setting ``lib_archive = no`` will instruct PlatformIO Build System to link "
"object files directly (in-line). This could be useful if you need to "
"override ``weak`` symbols defined in framework or other libraries."
msgstr ""

#: ../../../projectconf/sections/env/options/library/lib_archive.rst:27
msgid ""
"You can disable library archiving per a custom library using :ref:"
"`manifest_library_json_build_libArchive` field in :ref:`library_json` "
"manifest."
msgstr ""

