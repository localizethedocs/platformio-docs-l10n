#: ../../../integration/compile_commands.rst:37
msgid "``COMPILATIONDB_INCLUDE_TOOLCHAIN``"
msgstr ""

#: ../../../integration/compile_commands.rst:38
msgid ""
"A boolean flag to control if toolchain paths should be included in the "
"compilation unit. A default value is ``False``, only project-dependent "
"includes are exported."
msgstr ""

