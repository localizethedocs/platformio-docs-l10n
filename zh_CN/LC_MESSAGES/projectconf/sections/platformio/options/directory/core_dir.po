#: ../../../projectconf/sections/platformio/options/directory/core_dir.rst:15
msgid "``core_dir``"
msgstr ""

#: ../../../projectconf/sections/platformio/options/directory/core_dir.rst:17
msgid "Type: ``DirPath`` | Multiple: ``No``"
msgstr ""

#: ../../../projectconf/sections/platformio/options/directory/core_dir.rst:19
msgid ""
"The core_dir variable points out the directory used for all development "
"platform packages (toolchains, frameworks, SDKs, upload and debug tools), "
"global libraries for :ref:`ldf`, and other PlatformIO Core service data. The "
"size of this folder will depend on the number of installed development "
"platforms."
msgstr ""

#: ../../../projectconf/sections/platformio/options/directory/core_dir.rst:25
msgid "The default value is the user's home directory:"
msgstr ""

#: ../../../projectconf/sections/platformio/options/directory/core_dir.rst:27
msgid "Unix ``~/.platformio``"
msgstr ""

#: ../../../projectconf/sections/platformio/options/directory/core_dir.rst:28
msgid "Windows ``%HOMEPATH%\\.platformio``"
msgstr ""

#: ../../../projectconf/sections/platformio/options/directory/core_dir.rst:30
msgid ""
"This option can also be configured by the global environment variable :"
"envvar:`PLATFORMIO_CORE_DIR`."
msgstr ""

