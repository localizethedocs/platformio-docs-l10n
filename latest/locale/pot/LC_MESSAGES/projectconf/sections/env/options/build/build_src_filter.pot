#: ../../../projectconf/sections/env/options/build/build_src_filter.rst:15
msgid "``build_src_filter``"
msgstr ""

#: ../../../projectconf/sections/env/options/build/build_src_filter.rst:17
msgid "Type: ``String (Templates)`` | Multiple: ``Yes``"
msgstr ""

#: ../../../projectconf/sections/env/options/build/build_src_filter.rst:19
msgid ""
"This option allows one to specify which source files should be included or "
"excluded from :ref:`projectconf_pio_src_dir` for a build process. Filter "
"supports two templates:"
msgstr ""

#: ../../../projectconf/sections/env/options/build/build_src_filter.rst:23
msgid "``+<PATH>`` include template"
msgstr ""

#: ../../../projectconf/sections/env/options/build/build_src_filter.rst:24
msgid "``-<PATH>`` exclude template"
msgstr ""

#: ../../../projectconf/sections/env/options/build/build_src_filter.rst:26
msgid ""
"``PATH`` is relative to :ref:`projectconf_pio_src_dir`. All patterns will be "
"applied in their order of definition. `GLOB Patterns <http://en.wikipedia."
"org/wiki/Glob_(programming)>`_ are allowed."
msgstr ""

#: ../../../projectconf/sections/env/options/build/build_src_filter.rst:30
msgid ""
"By default, ``build_src_filter`` is predefined to ``+<*> -<.git/> -<.svn/"
">``, meaning \"include ALL files, then exclude the ``.git`` and ``.svn`` "
"repository folders."
msgstr ""

#: ../../../projectconf/sections/env/options/build/build_src_filter.rst:33
msgid ""
"This option can also be set by the global environment variable :envvar:"
"`PLATFORMIO_BUILD_SRC_FILTER`."
msgstr ""

#: ../../../projectconf/sections/env/options/build/build_src_filter.rst:36
msgid "**Example**"
msgstr ""

#: ../../../projectconf/sections/env/options/build/build_src_filter.rst:38
msgid ""
"Include all ``.c`` and ``.cpp`` files recursively (``**`` means ANY path) to "
"the build process but exclude assembly files ``.S`` and ``.asm``:"
msgstr ""
