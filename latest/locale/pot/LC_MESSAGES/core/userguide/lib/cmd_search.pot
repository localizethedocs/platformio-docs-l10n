msgid "Filter libraries by specified name (strict search)"
msgstr ""

#: ../../../core/userguide/lib/cmd_search.rst:93
msgid "Filter libraries by specified author"
msgstr ""

#: ../../../core/userguide/lib/cmd_search.rst:98
#: ../../../core/userguide/lib/cmd_search.rst:108
msgid "Filter libraries by specified keyword"
msgstr ""

#: ../../../core/userguide/lib/cmd_search.rst:103
msgid "Filter libraries by specified framework"
msgstr ""

#: ../../../core/userguide/lib/cmd_search.rst:113
msgid "Filter libraries by header file (include)"
msgstr ""

#: ../../../core/userguide/lib/cmd_search.rst:115
msgid "For example, ``pio lib search --header \"OneWire.h\"``"
msgstr ""

#: ../../../core/userguide/lib/cmd_search.rst:120
msgid "Return the output in `JSON <http://en.wikipedia.org/wiki/JSON>`_ format"
msgstr ""

#: ../../../core/userguide/lib/cmd_search.rst:125
msgid ""
"Manually paginate through search results. This option is useful in pair with "
"``--json-output``."
msgstr ""

#: ../../../core/userguide/lib/cmd_search.rst:129
msgid "Examples"
msgstr ""

