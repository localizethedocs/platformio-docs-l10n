msgstr ""

#: ../../../core/userguide/pkg/cmd_install.rst:451
msgid "``MAJOR`` - incompatible API changes"
msgstr ""

#: ../../../core/userguide/pkg/cmd_install.rst:452
msgid "``MINOR`` - add functionality (backwards-compatible)"
msgstr ""

#: ../../../core/userguide/pkg/cmd_install.rst:453
msgid "``PATCH`` - bug fixes (backwards-compatible)."
msgstr ""

#: ../../../core/userguide/pkg/cmd_install.rst:455
msgid ""
"The version requirements can take any of the following forms (see `Semver "
"cheatsheet <https://devhints.io/semver>`_):"
msgstr ""

#: ../../../core/userguide/pkg/cmd_install.rst:457
msgid ""
"``^1.2.3`` - any compatible version (new functionality in a backwards "
"compatible manner and patches are allowed, 1.x.x). **RECOMMENDED**"
msgstr ""

#: ../../../core/userguide/pkg/cmd_install.rst:459
msgid ""
"``~1.2.3`` - any version with the same major and minor versions, and an "
"equal or greater patch version"
msgstr ""

#: ../../../core/userguide/pkg/cmd_install.rst:461
msgid ""
"``>1.2.3`` - any version greater than ``1.2.3``. ``>=``, ``<``, and ``<=`` "
"are also possible"
msgstr ""

#: ../../../core/userguide/pkg/cmd_install.rst:463
msgid ""
"``>0.1.0,!=0.2.0,<0.3.0`` - any version greater than ``0.1.0``, not equal to "
"``0.2.0`` and less than ``0.3.0``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_install.rst:465
msgid "``1.2.3`` - an exact version number. Use only this exact version."
msgstr ""

