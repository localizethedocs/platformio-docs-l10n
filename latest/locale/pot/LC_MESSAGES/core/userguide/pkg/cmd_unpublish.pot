#: ../../../core/userguide/pkg/cmd_unpublish.rst:29
msgid ""
"This removes a package version from the registry, deleting its entry and "
"removing the tarball."
msgstr ""

#: ../../../core/userguide/pkg/cmd_unpublish.rst:32
msgid ""
"If no version is specified, or if all versions are removed then the root "
"package entry is removed from the registry entirely."
msgstr ""

#: ../../../core/userguide/pkg/cmd_unpublish.rst:35
msgid ""
"You can only remove a package version within 72 hours from the published "
"date."
msgstr ""

#: ../../../core/userguide/pkg/cmd_unpublish.rst:38
