msgid "``tier:NAME``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:83
msgid ""
"`tier:official <https://registry.platformio.org/search?q=tier%3Aofficial>`_ "
"matches high-quality official packages owned and maintained by `PlatformIO "
"Labs <https://piolabs.com>`__"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:85
msgid ""
"`tier:verified <https://registry.platformio.org/search?q=tier%3Averified>`_ "
"matches verified packages owned and maintained by third-party technology "
"partners"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:87
msgid ""
"`tier:community <https://registry.platformio.org/search?"
"q=tier%3Acommunity>`_ matches community packages."
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:91
msgid "Search by metadata"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:93
msgid "Search for packages by their metadata."
msgstr ""

