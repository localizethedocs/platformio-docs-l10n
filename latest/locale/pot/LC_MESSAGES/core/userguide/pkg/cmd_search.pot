#: ../../../core/userguide/pkg/cmd_search.rst:79
msgid "``type:NAME``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:80
msgid ""
"`type:library <https://registry.platformio.org/search?q=type%3Alibrary>`_ "
"matches only library packages"
msgstr ""

