msgid "``name:NAME``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:102
msgid ""
"`name:\"Adafruit BusIO\" <https://registry.platformio.org/search?"
"q=name%3A%22Adafruit+BusIO%22>`_ matches Adafruit BusIO library"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:104
msgid "``keyword:NAME``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:105
msgid ""
"`keyword:json <https://registry.platformio.org/search?q=keyword%3Ajson>`_ "
"matches packages by \"json\" keyword"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:107
msgid "``category:NAME``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:108
msgid ""
"`category:\"AI & ML\" <https://registry.platformio.org/search?"
"q=category%3A%22AI+%26+ML%22>`_ matches AI and ML compatible packages"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:112
msgid "Search by ownership or contribution"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:114
msgid ""
"Search for packages owned by the ``owner`` or maintained by the ``author``."
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:122
msgid "``owner:NAME``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:123
msgid ""
"`owner:espressif <https://registry.platformio.org/search?"
"q=owner%3Aespressif>`_ matches packages owned by Espressif Systems"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:125
msgid "``author:NAME``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:126
msgid ""
"`author:\"Paul Stoffregen\" <https://registry.platformio.org/search?"
"q=author%3A%22Paul+Stoffregen%22>`_ matches packages with Paul Stoffregen's "
"contribution"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:130
msgid "Filter by compatibility"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:132
msgid ""
"You can filter packages by compatibility using ``framework`` or ``platform`` "
"qualifier."
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:140
msgid "``framework:NAME``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:141
msgid ""
"`framework:arduino json <https://registry.platformio.org/search?"
"q=framework%3Aarduino+json>`_ matches JSON related packages compatible with "
"Arduino framework"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:143
msgid "``platform:NAME``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:144
msgid ""
"`platform:espressif32 <https://registry.platformio.org/search?"
"q=platform%3Aespressif32>`_ matches packages compatible with Espressif32 "
"development platform"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:148
msgid "Search by library header"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:150
msgid "You can search for libraries that contain header file."
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:158
msgid "``header:FILENAME``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:159
msgid ""
"`header:\"Adafruit_Sensor.h\" <https://registry.platformio.org/search?"
"q=header%3A%22Adafruit_Sensor.h%22>`_ matches packages that contain "
"``Adafruit_Sensor.h`` header/include file."
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:163
msgid "Filter by dependencies"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:165
msgid ""
"You can search for packages that depend on the specified package or for "
"package dependencies."
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:173
msgid "``dependent:OWNER/NAME``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:174
msgid ""
"`dependent:\"bblanchon/ArduinoJson\" <https://registry.platformio.org/search?"
"q=dependent%3A%22bblanchon%2FArduinoJson%22>`_ matches packages that depend "
"on `ArduinoJson <https://registry.platformio.org/libraries/bblanchon/"
"ArduinoJson>`__ library"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:176
msgid "``dependency:OWNER/NAME``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:177
msgid ""
"`dependency:\"painlessmesh/painlessMesh\" <https://registry.platformio.org/"
"search?q=dependency%3A%22painlessmesh%2FpainlessMesh%22>`_ matches "
"`painlessMesh <https://registry.platformio.org/libraries/painlessmesh/"
"painlessMesh>`__ dependencies"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:183
msgid "Search Operators"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:185
msgid "|PIOREGISTRY| supports the following operators:"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:191
msgid "Operator"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:194
msgid "``+``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:195
msgid ""
"A leading or trailing plus sign indicates that this word must be present in "
"the search result that is returned."
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:197
msgid ""
"`json +arduino <https://registry.platformio.org/search?q=json+%2Barduino>`__ "
"matches JSON-related packages that contain the \"arduino\" word in the "
"package metadata"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:200
msgid "``-``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:201
msgid ""
"A leading or trailing minus sign indicates that this word must not be "
"present in the search result that is returned."
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:203
msgid ""
"`json -mbed <https://registry.platformio.org/search?q=json+-mbed>`__ matches "
"JSON-related packages that do not contain the \"mbed\" word in the package "
"metadata"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:206
msgid "``*``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:207
msgid ""
"The asterisk serves as the truncation (or wildcard) operator. Unlike the "
"other operators, it is appended to the word to be affected. Words match if "
"they begin with the word preceding the ``*`` operator."
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:210
msgid ""
"`DHT* <https://registry.platformio.org/search?q=DHT*>`__ matches packages "
"that contain a word that starts with \"DHT\""
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:213
msgid "``\"``"
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:214
msgid ""
"A phrase that is enclosed within double quote (``\"``) characters matches "
"only packages that contain the phrase literally, as it was typed."
msgstr ""

#: ../../../core/userguide/pkg/cmd_search.rst:216
msgid ""
"`\"humidity sensor\" <https://registry.platformio.org/search?"
"q=%22humidity+sensor%22>`__ matches packages that contain the \"humidity "
"sensor\" phrase."
msgstr ""

