msgstr ""

#: ../../../core/userguide/lib/cmd_uninstall.rst:66
msgid "``1.2.3`` - an exact version number. Use only this exact version"
msgstr ""

#: ../../../core/userguide/lib/cmd_uninstall.rst:67
msgid ""
"``^1.2.3`` - any compatible version (exact version for ``1.x.x`` versions)"
msgstr ""

#: ../../../core/userguide/lib/cmd_uninstall.rst:68
msgid ""
"``~1.2.3`` - any version with the same major and minor versions, and an "
"equal or greater patch version"
msgstr ""

#: ../../../core/userguide/lib/cmd_uninstall.rst:70
msgid ""
"``>1.2.3`` - any version greater than ``1.2.3``. ``>=``, ``<``, and ``<=`` "
"are also possible"
msgstr ""

#: ../../../core/userguide/lib/cmd_uninstall.rst:72
msgid ""
"``>0.1.0,!=0.2.0,<0.3.0`` - any version greater than ``0.1.0``, not equal to "
"``0.2.0`` and less than ``0.3.0``"
msgstr ""

